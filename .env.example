# Copy to .env and adjust. All vars are optional except SIGNING_SECRET in prod.

# --- CHANGE THIS in any real deployment (HMAC key for authorization records) ---
AEGIS_SIGNING_SECRET=change-me-in-production

# --- Optional LLM (triage + report prose). Without it, Aegis runs tool-only. ---
# AEGIS_ANTHROPIC_API_KEY=sk-ant-...
# AEGIS_LLM_MODEL=claude-opus-4-8

# --- External scanners (auto-detected; leave unset to use built-in checks) ---
# AEGIS_NUCLEI_PATH=nuclei
# AEGIS_ZAP_API_URL=http://127.0.0.1:8080
# AEGIS_ZAP_API_KEY=your-zap-api-key

# --- Browser crawling ---
AEGIS_ENABLE_PLAYWRIGHT=true

# --- Safety throttles ---
AEGIS_DEFAULT_PER_HOST_RPS=4.0
AEGIS_DEFAULT_MAX_CONCURRENCY=8
AEGIS_DEFAULT_REQUEST_BUDGET=5000
AEGIS_DEFAULT_TIME_BUDGET_S=3600
AEGIS_AUTHORIZATION_TTL_HOURS=72

# --- Storage ---
# AEGIS_DB_URL=sqlite+aiosqlite:///./data/aegis.db
